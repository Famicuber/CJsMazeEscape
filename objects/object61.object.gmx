t=0;
x=384}

if !instance_exists(object76) and sprite_index=sprite56 {
audio_play_sound(SFXCJFallingPart1,1000,false)
timer=0
gravity=0.2
sprite_index=sprite71
image_speed=0.025}

if sprite_index=sprite71 and !audio_is_playing(SFXCJFallingPart1) and timer&gt;88 and y&gt;0 {
gravity=0
vspeed=0
x=0
y=0
instance_change(object294,true)}

//if vspeed=3 {image_index=1}

</string>
